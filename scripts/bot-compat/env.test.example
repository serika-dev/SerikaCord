# Copy to scripts/bot-compat/.env.test (git-ignored). Local docker stack only:
# guard.ts refuses to start unless these point at 127.0.0.1:55432 / 56379.
NODE_ENV=development
PORT=58080
POSTGRES_URI=postgres://serika:serika@127.0.0.1:55432/serika_compat
POSTGRES_MAX_POOL_SIZE=8
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=bot-compat-local-jwt-secret-not-for-production
API_BASE_URL=http://127.0.0.1:58080
GATEWAY_URL=ws://127.0.0.1:58080/api/v10/gateway
FRONTEND_URL=http://127.0.0.1:58080
ALLOWED_ORIGINS=http://127.0.0.1:58080
DISABLE_DISCORD_BOT=1
DISABLE_SEARCH_BACKFILL=1
