{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(bun test:*)",
      "Bash(bun run test:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run check:theme)",
      "Bash(bun run check:chat-media)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)",
      "Bash(git tag:*)",
      "Bash(rm -rf:*)",
      "Bash(psql:*)",
      "Bash(pg_dump:*)",
      "Bash(redis-cli:*)",
      "Bash(npx drizzle-kit push:*)",
      "Bash(npx drizzle-kit migrate:*)",
      "Bash(bunx drizzle-kit push:*)",
      "Bash(bunx drizzle-kit migrate:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)"
    ]
  }
}
