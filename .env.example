# SerikaCord Configuration
NODE_ENV=development
PORT=3000

# Database
MONGO_URI=mongodb://localhost:27017/serikacord
MONGO_DB_NAME=serikacord
MONGO_PASSWORD=your-mongo-password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Optional: key for field-level encryption at rest (OAuth tokens, bot tokens,
# private notes, appeals...). 32+ random characters, e.g. `openssl rand -base64 48`.
# Without it, fields are encrypted with the platform key stored in the database.
# Once set, NEVER change or remove it: values written with it become unreadable.
# FIELD_ENCRYPTION_KEY=
# Encrypt sensitive fields on write (reads always accept both forms). Canary and
# production share one database: only set this to 1 once production runs a
# release that can read encrypted fields.
# FIELD_ENCRYPTION_WRITES=1

# End-to-end encryption for DMs, group DMs and their calls
# (docs/architecture/e2ee.md). Same rollout rule: only set to 1 once production
# runs a release with the E2EE code, since canary and production share data.
# E2EE_ENABLED=1
# Pepper for the 6-digit PIN key backup (32+ random bytes, base64:
# `openssl rand -base64 32`). Required for PIN backups; without it the PIN
# routes answer 503 and apps fall back to the recovery passphrase / linking.
# Use the SAME value on canary and production, keep it out of the database,
# and NEVER change it once set: changing it destroys every PIN backup.
# E2EE_PIN_PEPPER=

# Backblaze B2 Storage
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=serikacord-media
B2_BUCKET_ID=your-bucket-id
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com

# CDN URL — B2 bucket fronted by a CDN mapped to the bucket root
CDN_URL=https://cdn.serika.chat

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://serikacord.com,https://serika.dev

# Email (AWS SES)
AWS_EMAIL_ENDPOINT=email-smtp.us-east-1.amazonaws.com
AWS_EMAIL_SMTP_PORT=587
AWS_EMAIL_SMTP_USERNAME=your-smtp-username
AWS_EMAIL_PASS=your-smtp-password
EMAIL_FROM=SerikaCord <noreply@serika.email>

# Discord OAuth
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Last.fm — API key + shared secret (register at https://www.last.fm/api/account/create)
LASTFM_API_KEY=your-lastfm-api-key
LASTFM_API_SECRET=your-lastfm-shared-secret

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Spotify OAuth (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Twitch OAuth (https://dev.twitch.tv/console)
# Also used to authenticate the IGDB game-metadata proxy (/api/igdb/game),
# which powers desktop rich-presence game detection, and for the Twitch server
# integration (go-live notifications + real test posts via Helix). Without
# them Twitch test posts use labelled sample details and nothing goes live.
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# Mobile push notifications (Firebase Cloud Messaging, HTTP v1 API).
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Paste the whole JSON on one line, or base64-encode it.
# Leave empty to disable pushes (the app still shows in-app/local notifications).
FCM_SERVICE_ACCOUNT_JSON=

# PhotoDNA Cloud Service (CSAM matching on image uploads; primary + fallback key)
PHOTODNA_KEY=
PHOTODNA_KEY_SECONDARY=
# Optional: the account's datacenter (default EU, https://eu-api.microsoftmoderator.com/photodna/v1.0/Match)
PHOTODNA_ENDPOINT=

# Steam Web API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=your-steam-api-key

# Public frontend URL (used for OAuth redirect callbacks)
FRONTEND_URL=https://serikacord.com

# OpenID Connect (Discord-compatible OAuth2 `openid` scope): RSA private key
# PEM (PKCS#8 or PKCS#1, `\n` escapes allowed) that signs id_tokens and is
# published at /api/v10/oauth2/keys. Unset = one key is generated and shared
# via Redis (encrypted). OIDC_ISSUER defaults to FRONTEND_URL.
OIDC_SIGNING_KEY=
OIDC_ISSUER=

# Stripe (for premium)
STRIPE_SECRET_KEY=sk_test_your-stripe-key

# Serika GIFs API
SERIKA_GIFS_API=https://gifs.serika.dev/api
SERIKA_GIFS_API_KEY=your-serika-gifs-api-key
# Legacy alias still supported by app code:
# SERIKA_GIFS=your-serika-gifs-api-key
# Extra GIF CDNs a favorite GIF may be imported from as an avatar/banner
# (comma separated; cdn.ado.wtf, *.serika.dev, Tenor and Giphy are built in).
# SERIKA_GIFS_MEDIA_HOSTS=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# File Upload Limits (in bytes)
MAX_FILE_SIZE=524288000
MAX_FILE_SIZE_PREMIUM=2147483648
MAX_AVATAR_SIZE=5242880
MAX_BANNER_SIZE=10485760
MAX_MESSAGE_LENGTH=4000

# SerikaMoe (streaming) — live "now watching" presence
SERIKA_MOE_URL=https://serika.moe
SERIKA_MOE_SERVICE_KEY=your-serika-moe-service-key
# Legacy alias also accepted:
# SERIKA_SERVICE_KEY=your-serika-moe-service-key

# Serika Wishlist — public wishlists for the profile Wishlist widget (no key needed;
# only lists their owners made public are ever returned).
NEXT_PUBLIC_SERIKA_WISHLIST_URL=https://wish.serika.dev

# Discord Bot (optional — for Discord bridge real-time sync)
# When enabled, the bot connects to Discord Gateway and forwards messages bidirectionally.
# Set DISABLE_DISCORD_BOT=1 on canary/dev instances to prevent dual bot connections.
SERIKA_DISCORD_TOKEN=your-discord-bot-token
SERIKA_DISCORD_ID=your-discord-bot-user-id
# DISABLE_DISCORD_BOT=1

# YouTube upload / Twitch go-live notifications for servers with the
# integration on (src/lib/integrations/poller.ts): YouTube's public feed every
# 10 min, Twitch every 2 min (needs TWITCH_CLIENT_ID/SECRET). One instance per
# pass (Redis lock); the first look at a channel only records a baseline.
# INTEGRATION_NOTIFICATIONS_DISABLED=1

# Deleted-content retention purge (src/lib/services/retentionPurge.ts).
# Permanently erases messages deleted more than RETENTION_PURGE_DAYS ago, plus
# the uploaded files only they used, as the Privacy Policy promises. Content
# tied to a message report, an open safety incident, a CSAM incident in the
# last year or an open appeal is kept. Runs hourly on one instance (Redis lock)
# and only after drizzle/manual_retention_purge.sql (indexes) is applied.
# Off by default. Turn it on in dry run first (logs "[retention] dry-run:
# would purge ..." and deletes nothing), check the numbers, then set
# RETENTION_PURGE_DRY_RUN=0 to delete for real. Report without the app:
#   bun scripts/retention-purge-report.ts
# RETENTION_PURGE_ENABLED=0
# RETENTION_PURGE_DRY_RUN=1
# RETENTION_PURGE_DAYS=30
# RETENTION_PURGE_BATCH_SIZE=100
# RETENTION_PURGE_MAX_SECONDS=60
# RETENTION_PURGE_INTERVAL_MINUTES=60

# Fish Audio TTS (optional — high-quality AI voices for /tts [fish:ID])
# Get your API key at https://fish.audio
# Voice presets are configured in the admin panel (TTS Management tab), not env vars.
FISH_API_KEY=your-fish-audio-api-key

# General Translation (i18n — https://generaltranslation.com)
# Get your keys at https://dash.generaltranslation.com or run `npx gt auth`
# Dev keys start with gtx-dev-, production keys start with gtx-api-
GT_PROJECT_ID=your-gt-project-id
GT_API_KEY=your-gt-api-key
